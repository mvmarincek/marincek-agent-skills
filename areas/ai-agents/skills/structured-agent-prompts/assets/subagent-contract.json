{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"AgentHandoff",
  "type":"object",
  "required":["task_id","agent_id","objective","allowed_tools","output_contract","deadline_iso","max_steps"],
  "properties":{
    "task_id":{"type":"string"},"parent_task_id":{"type":["string","null"]},
    "agent_id":{"type":"string"},"objective":{"type":"string","minLength":5},
    "input_refs":{"type":"array","items":{"type":"string"}},
    "scope":{"type":"object"},
    "allowed_tools":{"type":"array","items":{"type":"string"}},
    "output_contract":{"type":"object"},
    "deadline_iso":{"type":"string"},"max_steps":{"type":"integer","minimum":1},
    "budget":{"type":"object"},"retry_policy":{"type":"object"},
    "return_to":{"type":"string"},"tenant_id":{"type":"string"}
  },"additionalProperties":false
}
